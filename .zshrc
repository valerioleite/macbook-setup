export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="superjarin"

CASE_SENSITIVE="true"

plugins=(git zsh-autosuggestions zsh-syntax-highlighting fast-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

